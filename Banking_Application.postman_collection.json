				},
				{
					"name": "Inter-Bank Transfer $300 (Account 1 -> Account 2)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test(\"Source balance deducted to 1000.00\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data.balanceAfter).to.eql(1000.00);",
									"    pm.expect(jsonData.data.transactionType).to.eql(\"TRANSFER\");",
									"});"
								],
								"type": "text/javascript"
							}
						}

							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test(\"Contains transaction records\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data.content.length).to.be.at.least(3);",
									"});"
								],
								"type": "text/javascript"

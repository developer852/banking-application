		{
			"name": "2. Account Management",
			"item": [
				{
					"name": "Open Account for Customer 1 ($1000)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"pm.test(\"Account created with correct balance\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data.balance).to.eql(1000.00);",
									"    pm.expect(jsonData.data.status).to.eql(\"ACTIVE\");",
									"    pm.collectionVariables.set(\"account1_num\", jsonData.data.accountNumber);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"userId\": {{user1_id}},\n    \"accountType\": \"SAVINGS\",\n    \"initialDeposit\": 1000.00\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/accounts",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"accounts"
							]
						}
					}
				},
				{
					"name": "Open Account for Customer 2 ($200)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"pm.test(\"Account 2 created successfully\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data.balance).to.eql(200.00);",
									"    pm.collectionVariables.set(\"account2_num\", jsonData.data.accountNumber);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"userId\": {{user2_id}},\n    \"accountType\": \"CHECKING\",\n    \"initialDeposit\": 200.00\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/accounts",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"accounts"
							]
						}
					}
				},
				{
					"name": "Get Account Details",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test(\"Account details match\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data.accountNumber).to.eql(pm.collectionVariables.get(\"account1_num\"));",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/v1/accounts/{{account1_num}}",
							"host": [

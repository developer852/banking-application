		{
			"name": "3. Transactions & Transfers",
			"item": [
				{
					"name": "Deposit $500 to Account 1",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test(\"New balance is 1500.00\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data.balanceAfter).to.eql(1500.00);",
									"    pm.expect(jsonData.data.transactionType).to.eql(\"DEPOSIT\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
